---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.pages %}{% if not item.data.hidden %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    <lastmod>{{ site.built }}</lastmod>
    <priority>{% if item.url == '/' %}1.0{% else %}{{ item.data.priority or '0.7' }}{% endif %}</priority>
  </url>
{%- endif %}{% endfor %}
</urlset>
