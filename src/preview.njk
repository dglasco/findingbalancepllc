---
permalink: /preview.html
eleventyExcludeFromCollections: true
---
{#- Every page in one self-contained file, for review on a phone. Links are
    click handlers with no href, because in-app file viewers treat any href as
    leaving the page. Not for deployment. -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site.name }} | site preview</title>
<meta name="robots" content="noindex">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300;6..72,400&family=Karla:wght@400;700&display=swap">
<style>
{{ "src/assets/css/site.css" | readFile | safe }}
.page[hidden] { display: none; }
a[data-page] { cursor: pointer; }
</style>
</head>
<body>
<header class="masthead">
  <div class="shell masthead__inner">
    <a class="wordmark" data-page="home" role="link" tabindex="0">{{ site.name }}<span>{{ site.clinician }}</span></a>
    <button class="nav__toggle" type="button" aria-controls="primary-nav">Menu</button>
    <nav class="nav" id="primary-nav" aria-label="Primary" data-open="true">
      <ul>
      {%- for item in collections.pages | navItems %}
        <li><a data-page="{{ item.url | pageId }}" role="link" tabindex="0">{{ item.data.nav }}</a></li>
      {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
<main id="main">
{%- for item in collections.pages %}{% if not item.data.hidden %}
<div class="page" id="{{ item.url | pageId }}" hidden>
  {%- if item.url != '/' %}
  <nav class="shell crumbs" aria-label="Breadcrumb"><a data-page="home" role="link" tabindex="0">Home</a> / {{ item.data.nav }}</nav>
  {%- endif %}
  {{ item.templateContent | previewLinks | inlineImages | safe }}
</div>
{%- endif %}{% endfor %}
</main>
<footer class="footer">
  <div class="shell">
    <div class="footer__grid">
      <div>
        <h4>Get in touch</h4>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a><br>
        Supervision inquiries: <a href="mailto:{{ site.emailSupervision }}">{{ site.emailSupervision }}</a></p>
        <p>{{ site.city }}, Texas{% if site.postal %} {{ site.postal }}{% endif %}</p>
      </div>
      <div>
        <h4>Pages</h4>
        <ul>
        {%- for item in collections.pages %}{% if not item.data.hidden %}
          <li>{% if (item.url | depth) > 1 %}&nbsp;&nbsp;{% endif %}<a data-page="{{ item.url | pageId }}" role="link" tabindex="0">{{ item.data.nav }}</a></li>
        {%- endif %}{% endfor %}
        </ul>
      </div>
      <div>
        <h4>Hours</h4>
        <p>By appointment.<br>Walk and table therapy on Fridays.</p>
      </div>
    </div>
    <div class="footer__legal">
      <p>Preview build. Reem Glasco is a Licensed Professional Counselor Supervisor in Texas,
      license {{ site.license }}. Nothing on this site is therapy or supervision. In crisis,
      call 911, or call or text 988 for the Suicide and Crisis Lifeline.</p>
    </div>
  </div>
</footer>
<script>
{{ "src/assets/js/site.js" | readFile | safe }}
(function () {
  var pages = Array.prototype.slice.call(document.querySelectorAll('.page'));

  function show(id) {
    if (!pages.some(function (p) { return p.id === id; })) { id = pages[0].id; }
    pages.forEach(function (p) { p.hidden = p.id !== id; });
    document.querySelectorAll('[data-page]').forEach(function (el) {
      if (el.getAttribute('data-page') === id) { el.setAttribute('aria-current', 'page'); }
      else { el.removeAttribute('aria-current'); }
    });
    window.scrollTo(0, 0);
    var nav = document.getElementById('primary-nav');
    var toggle = document.querySelector('.nav__toggle');
    if (nav && toggle && window.matchMedia('(max-width: 55.99rem)').matches) {
      nav.setAttribute('data-open', 'false');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.textContent = 'Menu';
    }
  }

  function handle(event) {
    var el = event.target.closest('[data-page]');
    if (!el) { return; }
    event.preventDefault();
    show(el.getAttribute('data-page'));
  }
  document.addEventListener('click', handle);
  document.addEventListener('keydown', function (event) {
    if (event.key === 'Enter' || event.key === ' ') { handle(event); }
  });

  show('home');
})();
</script>
</body>
</html>
