<footer class="footer">
  <div class="shell">
    <div class="footer__grid">
      <div>
        <h4>Contact us</h4>
        {%- if site.phone %}
        <p><a href="tel:{{ site.phone | replace(" ", "") | replace("(", "") | replace(")", "") | replace("-", "") }}">{{ site.phone }}</a></p>
        {%- endif %}
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        <p>{{ site.city }}, Texas{% if site.postal %} {{ site.postal }}{% endif %}<br>
        Online across Texas. Walk and equine sessions by arrangement.</p>
      </div>
      {#- The section the reader is in, listed before the whole site. A page
          with no children of its own, or the home page, simply does not get
          this column and the grid falls back to three. -#}
      {%- set own = collections.pages | childrenOf(page.url) %}
      {%- set sectionUrl = page.url if own.length else page.url | parentOf %}
      {%- set hub = collections.pages | pageAt(sectionUrl) %}
      {%- set siblings = collections.pages | childrenOf(sectionUrl) %}
      {%- if hub and siblings.length and sectionUrl != "/" %}
      <div>
        <h4>{{ hub.data.nav }}</h4>
        <ul>
          <li><a href="{{ hub.url }}"{% if page.url == hub.url %} aria-current="page"{% endif %}>Overview</a></li>
        {%- for item in siblings %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.data.nav }}</a></li>
        {%- endfor %}
        </ul>
      </div>
      {%- endif %}
      <div>
        <h4>Pages</h4>
        <ul>
        {#- Same filter the masthead uses, so the two menus cannot drift. A page
            taken out of the top nav leaves the footer with it; Privacy is the
            one deliberate addition, because a footer is where people look for it. -#}
        {%- for item in collections.pages | navItems %}
          <li><a href="{{ item.url }}">{{ item.data.nav }}</a></li>
        {%- endfor %}
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </div>
      <div>
        <h4>Hours</h4>
        <p>By appointment.<br>
        Walk and talk therapy on Fridays.</p>
        {%- for p in site.profiles %}
        <p><a href="{{ p.url }}">{{ p.name }} profile</a></p>
        {%- endfor %}
      </div>
    </div>
    <div class="footer__legal">
      <p>Reem Glasco is a Licensed Professional Counselor Supervisor in Texas, license {{ site.license }}.
      Complaints about a Texas licensee go to the Texas Behavioral Health Executive Council,
      1-800-821-3205. Nothing on this site is therapy, supervision, or a substitute for either.
      If you are in immediate danger, call 911. For a mental health crisis, call or text 988
      for the Suicide and Crisis Lifeline.</p>
      <p>&copy; {{ site.year }} {{ site.legalName }}.</p>
    </div>
  </div>
</footer>
