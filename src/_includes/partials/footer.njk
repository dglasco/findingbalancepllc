<footer class="footer">
  <div class="shell">
    <div class="footer__grid">
      <div>
        <h4>Get in touch</h4>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a><br>
        Supervision enquiries: <a href="mailto:{{ site.emailSupervision }}">{{ site.emailSupervision }}</a></p>
        <p>{{ site.city }}, Texas {{ site.postal }}<br>
        Online across Texas. Walk and equine sessions by arrangement.</p>
      </div>
      <div>
        <h4>Pages</h4>
        <ul>
          <li><a href="/">Home</a></li>
        {%- for item in collections.pages %}{% if item.url != '/' and not item.data.hidden %}
          <li>{% if (item.url | depth) > 1 %}&nbsp;&nbsp;{% endif %}<a href="{{ item.url }}">{{ item.data.nav }}</a></li>
        {%- endif %}{% endfor %}
        </ul>
      </div>
      <div>
        <h4>Hours</h4>
        <p>By appointment.<br>
        Walk and table therapy on Fridays.</p>
        <p><a href="{{ site.psychologyToday }}">Psychology Today profile</a></p>
      </div>
    </div>
    <div class="footer__legal">
      <p>Reem Glasco is a Licensed Professional Counselor Supervisor in Texas, licence {{ site.license }}.
      Complaints about a Texas licensee go to the Texas Behavioral Health Executive Council,
      1-800-821-3205. Nothing on this site is therapy, supervision, or a substitute for either.
      If you are in crisis, call or text 988.</p>
      <p>&copy; {{ site.year }} {{ site.legalName }}.</p>
    </div>
  </div>
</footer>
