{#- The other posts, chosen by the build rather than by hand, so writing a
    fifth article links it from the other four without touching them. Four
    posts and no cross-links between any of them was the gap this closes. -#}
<section class="band band--sand">
  <div class="shell">
    <h2>More from Reem's blog</h2>
    <div class="pathways">
      {%- for post in collections.pages | childrenOf("/blog/") %}
      {%- if post.url != page.url %}
      <a href="{{ post.url }}">
        <h3>{{ post.data.nav }}</h3>
        <p>{{ post.data.description }}</p>
        <span class="card-go">Read more</span>
      </a>
      {%- endif %}
      {%- endfor %}
    </div>
  </div>
</section>
