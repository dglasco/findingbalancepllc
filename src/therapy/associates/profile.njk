---
pagination:
  data: associates
  size: 1
  alias: who
  # without this Eleventy puts only the first paginated page into collections,
  # so the other five would be missing from the sitemap
  addAllPagesToCollections: true
permalink: "/therapy/associates/{{ who.slug }}/"
layout: layouts/base.njk
tags: pages
eleventyComputed:
  title: "{{ who.name }}, {{ who.credential }} | Finding Balance Counseling"
  description: "{{ who.name }}, {{ who.credential }} at Finding Balance Counseling, Austin, supervised by Reem Glasco, LPC-S. {{ who.fee.split(',')[0] }}."
  nav: "{{ who.name }}"
  order: 7.5
  priority: 0.6
inNav: false
---
<section class="shell band">
  <p class="eyebrow">LPC Associate, supervised by <a href="/about/">Reem Glasco, LPC-S</a></p>
  <h1>{{ who.name }}</h1>
  <div class="split">
    <div>
      <div class="answer answer--card">
        <p>{{ who.approach }}</p>
      </div>
      {%- if who.bio %}
      <p>{{ who.bio | safe }}</p>
      {%- else %}
      <p>{{ who.name }} sees {{ who.sees | lower }} Fees are {{ who.fee | lower }}, and the
      consultation beforehand is free and commits you to nothing.</p>
      {%- endif %}
    </div>
    <div>
      {%- if who.photo %}
      {% bandArt "/assets/img/associates/" + who.photo, who.photoW, who.photoH, who.name + ", " + who.credential, "small" %}
      {%- endif %}
      <div class="cta-row">
        {%- if who.email %}
        <a class="cta" href="mailto:{{ who.email }}">Contact {{ who.name | first_name }}</a>
        {%- elif who.website %}
        <a class="cta" href="https://{{ who.website }}" rel="noopener">Contact {{ who.name | first_name }}<span class="vh"> (opens in a new tab)</span></a>
        {%- else %}
        <a class="cta" href="/contact/">Ask for an introduction</a>
        {%- endif %}
      </div>
      <dl class="facts">
        <div><dt>Fee</dt><dd>{{ who.fee }}</dd></div>
        <div><dt>Sliding scale</dt><dd>{{ who.sliding }}</dd></div>
        <div><dt>Consult</dt><dd>{{ who.consult }}</dd></div>
        <div><dt>Sees</dt><dd>{{ who.sees }}</dd></div>
        {%- if who.pronouns %}<div><dt>Pronouns</dt><dd>{{ who.pronouns }}</dd></div>{% endif %}
        <div><dt>Supervisor</dt><dd><a href="/about/">Reem Glasco, LPC-S</a>, Texas license {{ site.license }}</dd></div>
      </dl>
    </div>
  </div>
</section>

<section class="band band--sand">
  <div class="shell">
    <h2>What {{ who.name | first_name }} works with</h2>
    <ul class="plain">
      {%- for f in who.focus %}
      <li>{{ f }}</li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="shell band">
  <div class="split">
    <div>
      <h2>Getting in touch</h2>
      <p>{{ who.name }} runs their own scheduling, billing and paperwork, so booking goes
      directly to them rather than through the practice.</p>
      <dl class="facts">
        {%- if who.email %}<div><dt>Email</dt><dd><a href="mailto:{{ who.email }}">{{ who.email }}</a></dd></div>{% endif %}
        {%- if who.phone %}<div><dt>Phone</dt><dd><a href="tel:{{ who.phone | replace(" ", "") | replace("(", "") | replace(")", "") | replace("-", "") }}">{{ who.phone }}</a></dd></div>{% endif %}
        {%- if who.website %}<div><dt>Website</dt><dd><a href="https://{{ who.website }}" rel="noopener">{{ who.website }}</a><span class="vh"> (opens in a new tab)</span></dd></div>{% endif %}
        <div><dt>Consult</dt><dd>{{ who.consult }}</dd></div>
        {%- if not who.email and not who.phone and not who.website %}
        <div><dt>Booking</dt><dd><a href="/contact/">Ask the practice for an introduction</a></dd></div>
        {%- endif %}
      </dl>
    </div>
    <div>
      <h2>What supervision means here</h2>
      <p>An LPC Associate is fully qualified and licensed, and is completing the supervised hours
      Texas requires before full licensure. {{ who.name | first_name }}'s work is reviewed
      regularly by <a href="/about/">Reem Glasco, LPC-S</a>, which means two clinicians are
      thinking about your case rather than one.</p>
      <div class="cta-row">
        <a class="cta cta--quiet" href="/faq/">Fees and insurance</a>
      </div>
    </div>
  </div>
  {% include "partials/crisis-note.njk" %}
</section>

{#- Not the shared conversation band. On an associate's own page the practice
    inbox is the wrong first door: she does her own scheduling, and the page
    has just said so twice. -#}
<section class="band band--night">
  <div class="shell">
    <h2>Start with {{ who.name | first_name }}</h2>
    <p>{{ who.consult }}, and it commits you to nothing. If you are not sure whether
    {{ who.name | first_name }} is the right fit, say so in the first message, or ask the
    practice and you will be pointed at whoever is.</p>
    <div class="cta-row">
      {%- if who.email %}
      <a class="cta" href="mailto:{{ who.email }}">Contact {{ who.name | first_name }}</a>
      {%- elif who.website %}
      <a class="cta" href="https://{{ who.website }}" rel="noopener">Contact {{ who.name | first_name }}<span class="vh"> (opens in a new tab)</span></a>
      {%- endif %}
      <a class="cta cta--quiet" href="/therapy/associates/">All the associates</a>
      <a class="cta cta--quiet" href="/contact/">Not sure? Ask the practice</a>
    </div>
  </div>
</section>
