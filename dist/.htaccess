# Finding Balance Counseling - Apache config for IONOS Web Hosting.
#
# Upload this to the document root of findingbalances.com, alongside index.html.
# mod_rewrite is active by default on IONOS Web Hosting servers, and IONOS asks
# that RewriteBase be set explicitly.
#
# The site's canonical URLs and sitemap are extensionless (/lpc-supervision).
# Apache does not serve those without the rules below, so this file is not
# optional: without it every page would answer on two URLs and the canonical
# tag would point at a 404.

Options -Indexes
AddDefaultCharset UTF-8
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
RewriteBase /

# --- 1. HTTPS. Enable the free IONOS SSL certificate and confirm it has been
#        issued before switching this on, or the site will redirect to a
#        certificate warning.
RewriteCond %{SERVER_PORT} !=443
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://findingbalances.com/$1 [R=301,L]

# --- 2. One hostname. Apex is canonical here; to prefer www instead, swap the
#        two lines below and change the canonical host in build.py.
RewriteCond %{HTTP_HOST} ^www\.findingbalances\.com$ [NC]
RewriteRule ^(.*)$ https://findingbalances.com/$1 [R=301,L]

# --- 3. Send the .html form to the clean URL. THE_REQUEST holds the original
#        request line, so the internal rewrite in step 4 cannot retrigger this
#        and cause a loop.
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- 4. Serve /lpc-supervision from lpc-supervision.html.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# --- 5. Old WordPress paths that people and search engines still hold. Keep
#        these even after the old domain is redirected: some links point here.
Redirect 301 /supervision /lpc-supervision
Redirect 301 /group-therapy /lpc-supervision
Redirect 301 /emdr-cit-consultation /emdr-consultation
Redirect 301 /my-approach-to-therapy /approach
Redirect 301 /narm-neuroaffective-relational-model /approach
Redirect 301 /emdr /approach
Redirect 301 /somatic-experiencing-se /approach
Redirect 301 /services /therapy
Redirect 301 /counseling-for-trauma /therapy
Redirect 301 /therapy-for-depression /therapy
Redirect 301 /anxiety-therapist-austin-tx /therapy
Redirect 301 /social-anxiety-disorder-counseling /therapy
Redirect 301 /walk-therapy /retreats-training
Redirect 301 /rates-insurance /fees
Redirect 301 /appointment-request /contact
Redirect 301 /client-forms /contact
Redirect 301 /mental-health-links /faq
Redirect 301 /telehealth /faq
Redirect 301 /blog /retreats-training
Redirect 301 /books /about

# --- 6. Caching. The HTML is regenerated by hand, so keep it short; the
#        stylesheet and script are fingerprint-free, so keep them moderate
#        rather than immutable.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/plain "access plus 1 day"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- 7. The single-file review copy is not part of the public site. If it ends
#        up on the server by accident, this keeps it out of the index.
<Files "preview.html">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
  </IfModule>
</Files>
